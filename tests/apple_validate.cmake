# Optional check against Apple's public tools (metal-validate, metal-objdump from the Metal toolchain): the iOS and
# iOS Simulator libraries must be accepted, and the module must carry the triple and AIR version expected for the
# deployment target. Skipped by CMake when the tools are not installed.
# ARGS: CLI options for the input (default: one direct buffer binding); EXPECT: optional text the disassembly must contain.
if(NOT DEFINED ARGS)
  set(ARGS --buffer 0:0:0)
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
function(check_target name platform min_os triple air_minor)
  set(out "${OUTPUT_DIR}/${name}.metallib")
  execute_process(COMMAND "${CLI}" "${INPUT}" "${out}" ${ARGS} --platform ${platform} --min-os ${min_os}
    RESULT_VARIABLE result ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${name}: translation failed: ${error}")
  endif()
  execute_process(COMMAND "${VALIDATE}" "${out}" RESULT_VARIABLE result OUTPUT_VARIABLE text ERROR_VARIABLE text)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${name}: metal-validate rejected the library: ${text}")
  endif()
  execute_process(COMMAND "${OBJDUMP}" -d "${out}" RESULT_VARIABLE result OUTPUT_VARIABLE text ERROR_QUIET)
  if(NOT text MATCHES "target triple = \"${triple}\"")
    message(FATAL_ERROR "${name}: expected triple ${triple}")
  endif()
  if(NOT text MATCHES "= !{i32 2, i32 ${air_minor}, i32 0}")
    message(FATAL_ERROR "${name}: expected air.version 2.${air_minor}")
  endif()
  if(DEFINED EXPECT AND NOT text MATCHES "${EXPECT}")
    message(FATAL_ERROR "${name}: expected ${EXPECT} in the disassembly")
  endif()
endfunction()
check_target(mac macos 14.0 "air64_v26-apple-macosx14.0.0" 6)
check_target(ios18 ios 18.0 "air64_v27-apple-ios18.0.0" 7)
check_target(sim18 ios-simulator 18.0 "air64_v27-apple-ios18.0.0-simulator" 7)
check_target(ios26 ios 26.0 "air64_v28-apple-ios26.0.0" 8)
check_target(ios26_2 ios 26.2 "air64_v28-apple-ios26.2.0" 8)
check_target(sim26 ios-simulator 26.0 "air64_v28-apple-ios26.0.0-simulator" 8)
