; Pixel test shader for tests/frag_gpu.mm: the sample-rate inputs of fragment shaders.
; Reads gl_SampleID, gl_SampleMaskIn[0], a Sample-qualified interpolator, OpBitCount and OpIsHelperInvocationEXT.
; out = (float(SampleID), float(SampleMaskIn[0]), float(bitCount(mask * 1015 + SampleID * 65537)), a.x), and the
; counter at set 0 binding 1 (the ZPD counter, Coherent) += bitCount(mask) in the invocations that are not helpers.
               OpCapability Shader
               OpCapability SampleRateShading
               OpMemoryModel Logical GLSL450
               OpEntryPoint Fragment %main "main" %a %sid %smi %out
               OpExecutionMode %main OriginUpperLeft
               OpDecorate %a Location 0
               OpDecorate %a Sample
               OpDecorate %sid BuiltIn SampleId
               OpDecorate %sid Flat
               OpDecorate %smi BuiltIn SampleMask
               OpDecorate %smi Flat
               OpDecorate %out Location 0
               OpMemberDecorate %Counter 0 Offset 0
               OpDecorate %Counter Block
               OpDecorate %counter DescriptorSet 0
               OpDecorate %counter Binding 1
               OpDecorate %counter Coherent
       %void = OpTypeVoid
       %fnty = OpTypeFunction %void
       %bool = OpTypeBool
      %float = OpTypeFloat 32
        %int = OpTypeInt 32 1
       %uint = OpTypeInt 32 0
     %float4 = OpTypeVector %float 4
         %u0 = OpConstant %uint 0
         %u1 = OpConstant %uint 1
      %u1015 = OpConstant %uint 1015
     %u65537 = OpConstant %uint 65537
       %arr1 = OpTypeArray %int %u1
    %Counter = OpTypeStruct %uint
    %p_in_f4 = OpTypePointer Input %float4
   %p_in_int = OpTypePointer Input %int
  %p_in_arr1 = OpTypePointer Input %arr1
   %p_out_f4 = OpTypePointer Output %float4
   %p_sb_ctr = OpTypePointer StorageBuffer %Counter
    %p_sb_u = OpTypePointer StorageBuffer %uint
          %a = OpVariable %p_in_f4 Input
        %sid = OpVariable %p_in_int Input
        %smi = OpVariable %p_in_arr1 Input
        %out = OpVariable %p_out_f4 Output
    %counter = OpVariable %p_sb_ctr StorageBuffer
       %main = OpFunction %void None %fnty
      %entry = OpLabel
         %av = OpLoad %float4 %a
         %ax = OpCompositeExtract %float %av 0
       %sidv = OpLoad %int %sid
       %sidu = OpBitcast %uint %sidv
       %smip = OpAccessChain %p_in_int %smi %u0
      %maski = OpLoad %int %smip
      %maskv = OpBitcast %uint %maski
      %mixed = OpIMul %uint %maskv %u1015
         %sh = OpIMul %uint %sidu %u65537
        %sum = OpIAdd %uint %mixed %sh
         %bc = OpBitCount %uint %sum
         %mc = OpBitCount %uint %maskv
         %hp = OpIsHelperInvocationEXT %bool
               OpSelectionMerge %done None
               OpBranchConditional %hp %done %count
      %count = OpLabel
         %cp = OpAccessChain %p_sb_u %counter %u0
          %o = OpAtomicIAdd %uint %cp %u1 %u0 %mc
               OpBranch %done
       %done = OpLabel
         %f0 = OpConvertSToF %float %sidv
         %f1 = OpConvertUToF %float %maskv
         %f2 = OpConvertUToF %float %bc
         %ov = OpCompositeConstruct %float4 %f0 %f1 %f2 %ax
               OpStore %out %ov
               OpReturn
               OpFunctionEnd
