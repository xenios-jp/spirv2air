; Centroid from the primitive's raster coverage, in the forms Xenia's SPIR-V translator emits for it on Metal
; (tests/centroid_gpu.mm). glslang -V --target-env vulkan1.1 of:
;   layout(location = 0) in vec4 xe_in_interpolator_0;
;   layout(location = 1) noperspective in vec4 xe_in_interpolator_1;
;   layout(set = 1, binding = 0) uniform P { vec4 sp[4]; uvec4 n; };  // sample positions; count, full mask
;   vec4 a = xe_in_interpolator_0, b = xe_in_interpolator_1;
;   uint mask_in = uint(gl_SampleMaskIn[0]);
;   if (subgroupAny(mask_in != n.y)) {
;     vec3 bary = gl_BaryCoordNoPerspEXT, dx = dFdx(bary), dy = dFdy(bary);
;     uint covered = mask_in;
;     for (uint i = 0u; i < n.x; ++i)
;       if (all(greaterThanEqual(bary + dx * (sp[i].x - 0.5) + dy * (sp[i].y - 0.5), vec3(0.0)))) covered |= 1u << i;
;     if (covered != n.y) {
;       int sample_index = findLSB(covered);
;       a = interpolateAtSample(xe_in_interpolator_0, sample_index);
;       b = interpolateAtSample(xe_in_interpolator_1, sample_index);
;     }
;   }
;   o0 = a; o1 = b; gl_SampleMask[0] = -1;
