; Pixel test shader for tests/flat_gpu.mm: reads the varyings of flat.vert.spvasm (Flat float, Flat int2, Flat uint3,
; smooth float) and writes them to three render targets:
;   rt0 float4: (f, s, 0, 1)    rt1 int4: (i.x, i.y, 5, -9)    rt2 uint4: (u.x, u.y, u.z, 1)
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint Fragment %main "main" %f %i %u %s %o0 %o1 %o2
               OpExecutionMode %main OriginUpperLeft
               OpDecorate %f Location 0
               OpDecorate %f Flat
               OpDecorate %i Location 1
               OpDecorate %i Flat
               OpDecorate %u Location 2
               OpDecorate %u Flat
               OpDecorate %s Location 3
               OpDecorate %o0 Location 0
               OpDecorate %o1 Location 1
               OpDecorate %o2 Location 2
       %void = OpTypeVoid
       %fnty = OpTypeFunction %void
      %float = OpTypeFloat 32
        %int = OpTypeInt 32 1
       %uint = OpTypeInt 32 0
     %float4 = OpTypeVector %float 4
       %int2 = OpTypeVector %int 2
       %int4 = OpTypeVector %int 4
      %uint3 = OpTypeVector %uint 3
      %uint4 = OpTypeVector %uint 4
    %p_in_f = OpTypePointer Input %float
    %p_in_i2 = OpTypePointer Input %int2
    %p_in_u3 = OpTypePointer Input %uint3
    %p_out_f4 = OpTypePointer Output %float4
    %p_out_i4 = OpTypePointer Output %int4
    %p_out_u4 = OpTypePointer Output %uint4
          %f = OpVariable %p_in_f Input
          %i = OpVariable %p_in_i2 Input
          %u = OpVariable %p_in_u3 Input
          %s = OpVariable %p_in_f Input
         %o0 = OpVariable %p_out_f4 Output
         %o1 = OpVariable %p_out_i4 Output
         %o2 = OpVariable %p_out_u4 Output
       %f0 = OpConstant %float 0
       %f1 = OpConstant %float 1
       %i5 = OpConstant %int 5
       %im9 = OpConstant %int -9
       %u1 = OpConstant %uint 1
       %main = OpFunction %void None %fnty
      %entry = OpLabel
         %fv = OpLoad %float %f
         %sv = OpLoad %float %s
         %iv = OpLoad %int2 %i
         %uv = OpLoad %uint3 %u
        %r0 = OpCompositeConstruct %float4 %fv %sv %f0 %f1
               OpStore %o0 %r0
        %ix = OpCompositeExtract %int %iv 0
        %iy = OpCompositeExtract %int %iv 1
        %r1 = OpCompositeConstruct %int4 %ix %iy %i5 %im9
               OpStore %o1 %r1
        %ux = OpCompositeExtract %uint %uv 0
        %uy = OpCompositeExtract %uint %uv 1
        %uz = OpCompositeExtract %uint %uv 2
        %r2 = OpCompositeConstruct %uint4 %ux %uy %uz %u1
               OpStore %o2 %r2
               OpReturn
               OpFunctionEnd
