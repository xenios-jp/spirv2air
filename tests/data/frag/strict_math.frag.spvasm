; Same outputs as fma.frag.spvasm: scalar/vector contraction errors, strict zero and rounded product.
; FPFastMathMode None replaces NoContraction on the strict product/subtraction and must preserve the module bytes.
               OpCapability Shader
               OpCapability FloatControls2
               OpExtension "SPV_KHR_float_controls2"
               OpMemoryModel Logical GLSL450
               OpEntryPoint Fragment %main "main" %a %out
               OpExecutionMode %main OriginUpperLeft
               OpDecorate %a Location 0
               OpDecorate %out Location 0
               OpDecorate %p NoContraction
               OpDecorate %t2 FPFastMathMode None
               OpDecorate %r2 FPFastMathMode None
       %void = OpTypeVoid
       %uint = OpTypeInt 32 0
        %u2a5 = OpConstant %uint 677
       %fnty = OpTypeFunction %void
      %float = OpTypeFloat 32
     %float4 = OpTypeVector %float 4
     %float2 = OpTypeVector %float 2
    %p_in_f4 = OpTypePointer Input %float4
   %p_out_f4 = OpTypePointer Output %float4
          %a = OpVariable %p_in_f4 Input
        %out = OpVariable %p_out_f4 Output
       %main = OpFunction %void None %fnty
      %entry = OpLabel
         %av = OpLoad %float4 %a
        %ax0 = OpCompositeExtract %float %av 0
        %axu = OpBitcast %uint %ax0
        %axo = OpBitwiseOr %uint %axu %u2a5
         %ax = OpBitcast %float %axo
          %p = OpFMul %float %ax %ax
          %t = OpFMul %float %ax %ax
          %r = OpFSub %float %t %p
         %t2 = OpFMul %float %ax %ax
         %r2 = OpFSub %float %t2 %p
         %v2 = OpCompositeConstruct %float2 %ax %ax
         %vt = OpFMul %float2 %v2 %v2
         %pp = OpCompositeConstruct %float2 %p %p
         %vr = OpFSub %float2 %vt %pp
         %v0 = OpCompositeExtract %float %vr 0
         %v1 = OpCompositeExtract %float %vr 1
         %vs = OpFAdd %float %v0 %v1
         %ov = OpCompositeConstruct %float4 %r %r2 %vs %p
               OpStore %out %ov
               OpReturn
               OpFunctionEnd
