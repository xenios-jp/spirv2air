%oi12 = OpIAdd %u %obase %c12
%op12 = OpAccessChain %pu %outb %c0 %oi12
OpStore %op12 %r27
%oi13 = OpIAdd %u %obase %c13
%op13 = OpAccessChain %pu %outb %c0 %oi13
OpStore %op13 %r29
%oi14 = OpIAdd %u %obase %c14
%op14 = OpAccessChain %pu %outb %c0 %oi14
