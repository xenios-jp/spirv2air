%r27 = OpBitcast %u %r26
%r28 = OpCompositeExtract %f %r21 3
%r29 = OpBitcast %u %r28
%r30 = OpExtInst %f4 %glsl UnpackUnorm4x8 %w
%r31 = OpCompositeExtract %f %r30 0
%r32 = OpBitcast %u %r31
%r33 = OpCompositeExtract %f %r30 1
%r34 = OpBitcast %u %r33
%r35 = OpCompositeExtract %f %r30 2
%r36 = OpBitcast %u %r35
%r37 = OpCompositeExtract %f %r30 3
%r38 = OpBitcast %u %r37
%r39 = OpExtInst %u %glsl PackSnorm2x16 %fv
%r40 = OpExtInst %f2 %glsl UnpackSnorm2x16 %r39
%r41 = OpCompositeExtract %f %r40 0
%r42 = OpBitcast %u %r41
%r43 = OpCompositeExtract %f %r40 1
%r44 = OpBitcast %u %r43
%r45 = OpExtInst %f2 %glsl UnpackSnorm2x16 %w
%r46 = OpCompositeExtract %f %r45 0
%r47 = OpBitcast %u %r46
%r48 = OpCompositeExtract %f %r45 1
%r49 = OpBitcast %u %r48
%r50 = OpExtInst %u %glsl PackUnorm2x16 %fv
%r51 = OpExtInst %f2 %glsl UnpackUnorm2x16 %r50
%r52 = OpCompositeExtract %f %r51 0
%r53 = OpBitcast %u %r52
%r54 = OpCompositeExtract %f %r51 1
%r55 = OpBitcast %u %r54
%r56 = OpExtInst %f2 %glsl UnpackUnorm2x16 %w
%r57 = OpCompositeExtract %f %r56 0
%r58 = OpBitcast %u %r57
%r59 = OpCompositeExtract %f %r56 1
%r60 = OpBitcast %u %r59
%r61 = OpExtInst %u %glsl PackHalf2x16 %fv
%r62 = OpExtInst %f2 %glsl UnpackHalf2x16 %r61
%r63 = OpCompositeExtract %f %r62 0
%r64 = OpBitcast %u %r63
%r65 = OpCompositeExtract %f %r62 1
%r66 = OpBitcast %u %r65
%obase = OpIMul %u %gx %c31
%oi0 = OpIAdd %u %obase %c0
%op0 = OpAccessChain %pu %outb %c0 %oi0
OpStore %op0 %r1
%oi1 = OpIAdd %u %obase %c1
%op1 = OpAccessChain %pu %outb %c0 %oi1
OpStore %op1 %r4
%oi2 = OpIAdd %u %obase %c2
%op2 = OpAccessChain %pu %outb %c0 %oi2
OpStore %op2 %r6
