%r27 = OpCompositeExtract %f %r26 0
%r28 = OpBitcast %u %r27
%r29 = OpCompositeExtract %f %r26 1
%r30 = OpBitcast %u %r29
%r31 = OpExtInst %f2 %glsl Fma %fv %fw %fz
%r32 = OpCompositeExtract %f %r31 0
%r33 = OpBitcast %u %r32
%r34 = OpCompositeExtract %f %r31 1
%r35 = OpBitcast %u %r34
%r36 = OpQuantizeToF16 %f2 %fv
%r37 = OpCompositeExtract %f %r36 0
%r38 = OpBitcast %u %r37
%r39 = OpCompositeExtract %f %r36 1
%r40 = OpBitcast %u %r39
%r41 = OpIsInf %b2 %fv
%r42 = OpSelect %u2 %r41 %uz %uv
%r43 = OpCompositeExtract %u %r42 0
%r44 = OpCompositeExtract %u %r42 1
%r45 = OpExtInst %ff %glsl ModfStruct %fv
%r46 = OpCompositeExtract %f2 %r45 0
%r47 = OpCompositeExtract %f %r46 0
%r48 = OpBitcast %u %r47
%r49 = OpCompositeExtract %f %r46 1
%r50 = OpBitcast %u %r49
%r51 = OpCompositeExtract %f2 %r45 1
%r52 = OpCompositeExtract %f %r51 0
%r53 = OpBitcast %u %r52
%r54 = OpCompositeExtract %f %r51 1
%r55 = OpBitcast %u %r54
%r56 = OpExtInst %fi %glsl FrexpStruct %fv
%r57 = OpCompositeExtract %f2 %r56 0
%r58 = OpCompositeExtract %f %r57 0
%r59 = OpBitcast %u %r58
%r60 = OpCompositeExtract %f %r57 1
%r61 = OpBitcast %u %r60
%r62 = OpCompositeExtract %i2 %r56 1
%r63 = OpCompositeExtract %i %r62 0
%r64 = OpBitcast %u %r63
%r65 = OpCompositeExtract %i %r62 1
%r66 = OpBitcast %u %r65
%r67 = OpExtInst %f2 %glsl Modf %fv %whole
%r68 = OpCompositeExtract %f %r67 0
%r69 = OpBitcast %u %r68
%r70 = OpCompositeExtract %f %r67 1
%r71 = OpBitcast %u %r70
%r72 = OpLoad %f2 %whole
%r73 = OpCompositeExtract %f %r72 0
%r74 = OpBitcast %u %r73
%r75 = OpCompositeExtract %f %r72 1
%r76 = OpBitcast %u %r75
%r77 = OpExtInst %f2 %glsl Frexp %fv %exponent
%r78 = OpCompositeExtract %f %r77 0
%r79 = OpBitcast %u %r78
%r80 = OpCompositeExtract %f %r77 1
%r81 = OpBitcast %u %r80
%r82 = OpLoad %i2 %exponent
%r83 = OpCompositeExtract %i %r82 0
%r84 = OpBitcast %u %r83
%r85 = OpCompositeExtract %i %r82 1
%r86 = OpBitcast %u %r85
%r87 = OpExtInst %f2 %glsl Ldexp %fv %exps
%r88 = OpCompositeExtract %f %r87 0
%r89 = OpBitcast %u %r88
%r90 = OpCompositeExtract %f %r87 1
%r91 = OpBitcast %u %r90
%obase = OpIMul %u %gx %c36
%oi0 = OpIAdd %u %obase %c0
%op0 = OpAccessChain %pu %outb %c0 %oi0
OpStore %op0 %r3
%oi1 = OpIAdd %u %obase %c1
%op1 = OpAccessChain %pu %outb %c0 %oi1
OpStore %op1 %r5
