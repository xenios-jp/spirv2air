; Runtime inputs and CPU references are in tests/compute_gpu.mm.
OpCapability Shader
%glsl = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "main" %gid
OpExecutionMode %main LocalSize 64 1 1
OpDecorate %gid BuiltIn GlobalInvocationId
OpDecorate %arr ArrayStride 4
OpMemberDecorate %Buf 0 Offset 0
OpDecorate %Buf Block
OpDecorate %inb DescriptorSet 0
OpDecorate %inb Binding 0
OpDecorate %outb DescriptorSet 0
OpDecorate %outb Binding 1
%void = OpTypeVoid
%fn = OpTypeFunction %void
%u = OpTypeInt 32 0
%i = OpTypeInt 32 1
%f = OpTypeFloat 32
%b = OpTypeBool
%u2 = OpTypeVector %u 2
%i2 = OpTypeVector %i 2
%f2 = OpTypeVector %f 2
%f4 = OpTypeVector %f 4
%b2 = OpTypeVector %b 2
%u3 = OpTypeVector %u 3
%uu = OpTypeStruct %u2 %u2
%ii = OpTypeStruct %i2 %i2
%ff = OpTypeStruct %f2 %f2
%fi = OpTypeStruct %f2 %i2
%arr = OpTypeRuntimeArray %u
%Buf = OpTypeStruct %arr
%pb = OpTypePointer StorageBuffer %Buf
%pu = OpTypePointer StorageBuffer %u
%pg = OpTypePointer Input %u3
%pf2 = OpTypePointer Function %f2
%pi2 = OpTypePointer Function %i2
%inb = OpVariable %pb StorageBuffer
%outb = OpVariable %pb StorageBuffer
%gid = OpVariable %pg Input
%c0 = OpConstant %u 0
%c1 = OpConstant %u 1
%c2 = OpConstant %u 2
%c3 = OpConstant %u 3
%c4 = OpConstant %u 4
%c5 = OpConstant %u 5
%c6 = OpConstant %u 6
%c7 = OpConstant %u 7
%c8 = OpConstant %u 8
%c9 = OpConstant %u 9
%c10 = OpConstant %u 10
%c11 = OpConstant %u 11
%c12 = OpConstant %u 12
%c13 = OpConstant %u 13
%c14 = OpConstant %u 14
%c15 = OpConstant %u 15
%c16 = OpConstant %u 16
%c17 = OpConstant %u 17
%c18 = OpConstant %u 18
%c19 = OpConstant %u 19
%c20 = OpConstant %u 20
%c21 = OpConstant %u 21
%c22 = OpConstant %u 22
%c23 = OpConstant %u 23
%c24 = OpConstant %u 24
%c25 = OpConstant %u 25
%c26 = OpConstant %u 26
%c27 = OpConstant %u 27
%c28 = OpConstant %u 28
%c29 = OpConstant %u 29
%c30 = OpConstant %u 30
%c31 = OpConstant %u 31
%c32 = OpConstant %u 32
%c33 = OpConstant %u 33
%c34 = OpConstant %u 34
%c35 = OpConstant %u 35
%c36 = OpConstant %u 36
%im1 = OpConstant %i -1
%ip2 = OpConstant %i 2
%exps = OpConstantComposite %i2 %im1 %ip2
%main = OpFunction %void None %fn
%entry = OpLabel
%whole = OpVariable %pf2 Function
%exponent = OpVariable %pi2 Function
%g = OpLoad %u3 %gid
%gx = OpCompositeExtract %u %g 0
%base = OpIMul %u %gx %c4
%idx0 = OpIAdd %u %base %c0
%px = OpAccessChain %pu %inb %c0 %idx0
%x = OpLoad %u %px
%idx1 = OpIAdd %u %base %c1
%py = OpAccessChain %pu %inb %c0 %idx1
%y = OpLoad %u %py
%idx2 = OpIAdd %u %base %c2
%pz = OpAccessChain %pu %inb %c0 %idx2
%z = OpLoad %u %pz
%idx3 = OpIAdd %u %base %c3
%pw = OpAccessChain %pu %inb %c0 %idx3
%w = OpLoad %u %pw
%uv = OpCompositeConstruct %u2 %x %y
%uw = OpCompositeConstruct %u2 %y %z
%iv = OpBitcast %i2 %uv
%iw = OpBitcast %i2 %uw
%fv = OpBitcast %f2 %uv
%fw = OpBitcast %f2 %uw
%uz = OpCompositeConstruct %u2 %z %w
%fz = OpBitcast %f2 %uz
%fv4 = OpCompositeConstruct %f4 %fv %fz
%r1 = OpFRem %f2 %fv %fw
%r2 = OpCompositeExtract %f %r1 0
%r3 = OpBitcast %u %r2
%r4 = OpCompositeExtract %f %r1 1
%r5 = OpBitcast %u %r4
%r6 = OpFMod %f2 %fv %fw
%r7 = OpCompositeExtract %f %r6 0
%r8 = OpBitcast %u %r7
%r9 = OpCompositeExtract %f %r6 1
%r10 = OpBitcast %u %r9
