; Compute test shader for tests/math_gpu.mm: the GLSL.std.450 math and geometric instructions added in batch 1.
; Row r of the input buffer holds 12 floats, the vec4s a, b, c; the output row (221 floats) is, in order: for the
; scalars sa = a.x, sb = b.x, sc = c.x then the vec2, vec3 and vec4 forms (a, b, c truncated), the 17 results
; Round Tan Asin Acos Atan Atan2(a,b) Sinh Cosh Tanh Asinh Acosh Atanh Radians Degrees FMix(a,b,c) Step(a,b)
; SmoothStep(a,b,c); then for vec2, vec3, vec4: Length(a) Distance(a,b) Normalize(a) FaceForward(a,b,c) Reflect(a,b)
; Refract(a,b,sc); then Cross(a.xyz,b.xyz); then the scalar Length, Distance, Normalize, FaceForward, Reflect, Refract.
OpCapability Shader
%glsl = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "main" %gid
OpExecutionMode %main LocalSize 64 1 1
OpDecorate %gid BuiltIn GlobalInvocationId
OpDecorate %arr ArrayStride 4
OpMemberDecorate %Buf 0 Offset 0
OpDecorate %Buf Block
OpDecorate %inb DescriptorSet 0
OpDecorate %inb Binding 0
OpDecorate %outb DescriptorSet 0
OpDecorate %outb Binding 1
%void = OpTypeVoid
%fn = OpTypeFunction %void
%u = OpTypeInt 32 0
%i = OpTypeInt 32 1
%f = OpTypeFloat 32
%v2 = OpTypeVector %f 2
%v3 = OpTypeVector %f 3
%v4 = OpTypeVector %f 4
%u3 = OpTypeVector %u 3
%f0 = OpConstant %f 0
%arr = OpTypeRuntimeArray %f
%Buf = OpTypeStruct %arr
%pb = OpTypePointer StorageBuffer %Buf
%pf = OpTypePointer StorageBuffer %f
%pg = OpTypePointer Input %u3
%inb = OpVariable %pb StorageBuffer
%outb = OpVariable %pb StorageBuffer
%gid = OpVariable %pg Input
